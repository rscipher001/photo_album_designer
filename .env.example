# Photo directory to browse (absolute path on host)
PHOTOS_DIR=/path/to/your/photos

# Optional: Override default storage locations
# UPLOAD_DIR=./storage/uploads
# THUMBNAIL_DIR=./storage/thumbnails
# PROJECT_DIR=./storage/projects

# Application settings
# MAX_UPLOAD_SIZE=50mb
# THUMBNAIL_SIZES=150,300,600
# PORT=3000