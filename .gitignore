# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production builds
frontend/dist/
backend/public/
*.tgz

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Storage directories (user data)
storage/uploads/*
storage/thumbnails/*
storage/projects/*
sample-photos/*

# Keep directory structure but ignore contents
!storage/uploads/.gitkeep
!storage/thumbnails/.gitkeep
!storage/projects/.gitkeep
!sample-photos/.gitkeep

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

